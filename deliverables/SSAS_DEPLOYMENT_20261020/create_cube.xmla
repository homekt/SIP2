          <Source>
            <DataSourceViewID>SalesDSV</DataSourceViewID>
          </Source>
          <MdxScripts>
            <MdxScript>
              <ID>Calculations</ID>
              <Name>Calculations</Name>
              <Commands>
                <Command>
                  <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Gross Margin Percent] AS
 IIF([Measures].[Net Sales USD]=0,NULL,[Measures].[Gross Profit USD]/[Measures].[Net Sales USD]),FORMAT_STRING='0.00%',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Return Rate Percent] AS
 IIF([Measures].[Sales Quantity KG]=0,NULL,[Measures].[Return Quantity KG]/[Measures].[Sales Quantity KG]),FORMAT_STRING='0.00%',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Average Selling Price USD per KG] AS
 IIF([Measures].[Net Quantity KG]=0,NULL,[Measures].[Net Sales USD]/[Measures].[Net Quantity KG]),FORMAT_STRING='#,##0.0000',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Net Sales Local] AS
 IIF(COUNT(NONEMPTY(EXISTING [Local Currency].[Currency].[Currency].MEMBERS,[Measures].[Sales Line Count]))=1,[Measures].[Net Sales Local Raw],NULL),FORMAT_STRING='#,##0.00',VISIBLE=1;
CREATE MEMBER CURRENTCUBE.[Measures].[Gross Profit Local] AS
 IIF(COUNT(NONEMPTY(EXISTING [Local Currency].[Currency].[Currency].MEMBERS,[Measures].[Sales Line Count]))=1,[Measures].[Gross Profit Local Raw],NULL),FORMAT_STRING='#,##0.00',VISIBLE=1;</Text>
                </Command>
              </Commands>
            </MdxScript>
          </MdxScripts>
        </Cube>
